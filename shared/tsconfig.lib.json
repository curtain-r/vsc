{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "compilerOptions": {
    "outDir": "lib",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "module": "ESNext",
    "rootDir": "src",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "composite": true,
    "preserveConstEnums": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/__tests__/*", "*.test.ts"]
}